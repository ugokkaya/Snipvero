<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Menu bar app: no Dock icon, no app menu. Merged into the bundle by the Tauri bundler. -->
  <key>LSUIElement</key>
  <true/>
  <!-- Apple allows only up to three integers here, so the pre-release suffix of the package version
       (0.1.0-beta.1) is dropped; CFBundleVersion (bundle.macOS.bundleVersion) tells builds apart.
       Overrides the bundler's value; a Rust test keeps it equal to the package version's core. -->
  <key>CFBundleShortVersionString</key>
  <string>0.1.0</string>
</dict>
</plist>
