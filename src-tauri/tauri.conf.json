{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snipvero",
  "version": "0.1.0-beta.1",
  "identifier": "com.snipvero.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Snipvero",
        "width": 520,
        "height": 480,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Utility",
    "license": "MIT",
    "copyright": "© 2026 Snipvero Contributors",
    "publisher": "Snipvero contributors",
    "homepage": "https://github.com/ugokkaya/Snipvero",
    "shortDescription": "Screenshot and annotation tool",
    "longDescription": "Capture a region of the screen, mark it up with arrows, rectangles and text, then copy it or save it as PNG. Runs in the menu bar and works offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "bundleVersion": "1",
      "signingIdentity": "-"
    }
  }
}
